# Docker Compose host-level secrets/settings.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# One Telegram bot is shared by all AlgoTradeDynamics users.
# Create it with @BotFather, then copy the token and bot username here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_LINK_EXPIRE_MINUTES=10
