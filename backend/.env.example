# Application
APP_NAME=AlgoTradeDynamics API
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/algotrade

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backtest
DEFAULT_DATASET=data/btc_usdt_2024.csv

# Auth / JWT
JWT_SECRET_KEY=dev-secret-change-me-0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

BYBIT_DEMO_API_KEY=api_key
BYBIT_DEMO_API_SECRET=api_secret
