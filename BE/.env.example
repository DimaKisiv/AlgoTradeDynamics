DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/algotrade
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
ENVIRONMENT=development
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=atd_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY_HEADERS=false
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_API_REQUESTS=300
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_API_WRITE_REQUESTS=120
RATE_LIMIT_API_WRITE_WINDOW_SECONDS=60
EXCHANGE_EMULATOR_URL=http://localhost:8001
EXCHANGE_EMULATOR_DEFAULT_API_KEY=emulator-default-key
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_LINK_EXPIRE_MINUTES=10
TELEGRAM_POLL_TIMEOUT_SECONDS=20
TELEGRAM_DELIVERY_INTERVAL_SECONDS=2

# Compliance audit trail
AUDIT_JURISDICTION=EU
AUDIT_RETENTION_YEARS=5

# Compliance / privacy / operations policy
HOSTING_TARGET_REGION=EU/EEA
HOSTING_PROVIDER=Configurable production provider
OPERATIONS_LOG_RETENTION_DAYS=90
INCIDENT_RETENTION_DAYS=365
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=7
MONTHLY_BACKUP_RETENTION_MONTHS=6
RECOVERY_POINT_OBJECTIVE_HOURS=24
RECOVERY_TIME_OBJECTIVE_HOURS=4
